{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "outDir": "dist",
      "declaration": true,
      "declarationMap": false,
      "sourceMap": false,
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["index.ts", "expressServer.ts"]
  }
  