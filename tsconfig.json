{
  "compilerOptions": {
    "typeRoots": ["./gql/types"],
    // "baseUrl": ".",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "Node16",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "incremental": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "moduleResolution": "node16"
  },
  "exclude": ["node_modules"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "next.config.js"
  ]
}
