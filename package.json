{
  "name": "@unchainedshop/admin-ui",
  "version": "4.0.8",
  "description": "Unchained commerce Admin UI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "out"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./express": {
      "import": "./dist/express.js"
    },
    "./fastify": {
      "import": "./dist/fastify.js"
    }
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4010/graphql NODE_OPTIONS='--inspect' next dev ",
    "build": "node ./generate-permissions.js &&  next build && npm run build:lib",
    "build:lib": "tsc -p tsconfig.build.json",
    "start": "next start",
    "lint": "next lint",
    "format": "eslint --fix --ext .ts,.tsx,.js,.jsx .",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json --format custom-formatter.js",
    "test:e2e": "cypress open",
    "test:component": "cypress open --component",
    "test:e2e-record": "cypress run --browser chrome --record",
    "version:patch": "npm version patch && npm run tag",
    "version:minor": "npm version minor && npm run tag",
    "version:major": "npm version major && npm run tag",
    "tag": "git push --follow-tags",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (http://www.unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (http://www.unchained.shop)",
    "Mikael Araya Mengistu <mikael@unchained.shop> (http://www.unchained.shop)"
  ],
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@ai-sdk/react": "^1.2.12",
    "@apollo/client": "^3.13.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@formatjs/cli": "^6.7.1",
    "@formatjs/intl-pluralrules": "^5.4.4",
    "@formatjs/intl-relativetimeformat": "^11.4.11",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/express": "^5.0.3",
    "@types/react": "19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "classnames": "^2.5.1",
    "cypress": "^13.17.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "deepmerge": "^4.3.1",
    "dotenv-extended": "^2.9.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^5.1.0",
    "eslint-plugin-formatjs": "^5.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "formik": "^2.4.6",
    "globals": "^16.2.0",
    "graphql": "^16.11.0",
    "intl-messageformat": "^10.7.16",
    "lodash.isequal": "^4.5.0",
    "next": "15.3.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-intl": "^7.1.11",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.1",
    "react-toastify": "^11.0.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "validator": "^13.15.15",
    "zod": "^3.25.67"
  },
  "peerDependencies": {
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "express": "^5.1.0",
    "fastify": "^5.4.0"
  },
  "peerDependencyMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "overrides": {
    "@types/react": "19.1.7"
  },
  "dependencies": {
    "ai": "^4.3.16"
  }
}
