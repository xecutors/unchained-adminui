{
  "name": "admin-ui",
  "private": true,
  "version": "2.0.2",
  "description": "Unchained commerce Admin UI",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev ",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "eslint --fix --ext .ts,.tsx,.js,.jsx .",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json --format custom-formatter.js",
    "test:e2e": "cypress open",
    "test:e2e-record": "cypress run --browser chrome --record",
    "version": "run-p --print-label && npm version --no-git-tag-version patch && git add .",
    "tag": "git tag v$npm_package_version && git push origin v$npm_package_version",
    "version-n-tag": "run-p --print-label && npm  version && npm run tag"
  },
  "engines": {
    "node": "16.x"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (http://www.unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (http://www.unchained.shop)",
    "Mikael Araya Mengistu <mikael@unchained.shop> (http://www.unchained.shop)"
  ],
  "dependencies": {
    "@apollo/client": "^3.7.9",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.0",
    "@formatjs/intl-pluralrules": "^5.0.3",
    "@formatjs/intl-relativetimeformat": "^11.0.3",
    "@graphql-tools/links": "^8.3.31",
    "@graphql-tools/wrap": "^9.3.6",
    "@headlessui/react": "^1.7.11",
    "@heroicons/react": "^2.0.14",
    "@tailwindcss/forms": "^0.5.2",
    "accepts": "^1.3.8",
    "apollo-upload-client": "^17.0.0",
    "chart.js": "^3.9.1",
    "classnames": "^2.3.1",
    "cookie": "^0.5.0",
    "cross-fetch": "^3.1.5",
    "crypto-hash": "^2.0.1",
    "d3": "^7.8.2",
    "date-fns": "^2.29.1",
    "date-fns-tz": "^2.0.0",
    "deepmerge": "^4.3.0",
    "dotenv-extended": "^2.9.0",
    "formik": "^2.2.9",
    "graphql": "^16.6.0",
    "http-proxy": "^1.18.1",
    "intl-messageformat": "^10.3.1",
    "isomorphic-unfetch": "^4.0.2",
    "lodash": "^4.17.21",
    "lodash.isequal": "^4.5.0",
    "next": "^13.1.6",
    "next-pwa": "^5.5.5",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^4.3.1",
    "react-datepicker": "^4.10.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.0",
    "react-intl": "^6.2.7",
    "react-markdown": "^8.0.5",
    "react-select": "^5.4.0",
    "react-toastify": "^9.0.8",
    "rehype-raw": "^6.1.1",
    "rehype-sanitize": "^5.0.1",
    "remark-gfm": "^3.0.1",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.0.3",
    "@tailwindcss/typography": "^0.5.9",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.53.0",
    "autoprefixer": "^10.4.8",
    "cypress": "^12.5.1",
    "eslint": "^8.34.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "13.1.6",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-formatjs": "^4.7.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "prettier": "^2.8.3",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.5"
  }
}
