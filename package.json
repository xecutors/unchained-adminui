{
  "name": "admin-ui",
  "private": true,
  "version": "4.0.1",
  "description": "Unchained commerce Admin UI",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev ",
    "dev:turbo": "NODE_OPTIONS='--inspect' next dev --turbo ",
    "build": "node ./generate-permissions.js && next build",
    "start": "next start",
    "export": "next export",
    "lint": "next lint",
    "format": "eslint --fix --ext .ts,.tsx,.js,.jsx .",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json --format custom-formatter.js",
    "test:e2e": "cypress open",
    "test:component": "cypress open --component",
    "test:e2e-record": "cypress run --browser chrome --record",
    "version:patch": "npm version patch && npm run tag",
    "version:minor": "npm version minor && npm run tag",
    "version:major": "npm version major && npm run tag",
    "tag": "git push --follow-tags",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (http://www.unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (http://www.unchained.shop)",
    "Mikael Araya Mengistu <mikael@unchained.shop> (http://www.unchained.shop)"
  ],
  "dependencies": {
    "@apollo/client": "^3.12.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/intl-pluralrules": "^5.4.2",
    "@formatjs/intl-relativetimeformat": "^11.4.9",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "deepmerge": "^4.3.1",
    "dotenv-extended": "^2.9.0",
    "formik": "^2.4.6",
    "graphql": "^16.10.0",
    "http-proxy-middleware": "^3.0.3",
    "intl-messageformat": "^10.7.11",
    "lodash.isequal": "^4.5.0",
    "next": "^14.2.23",
    "react": "18.2",
    "react-datepicker": "^7.6.0",
    "react-dom": "18.2",
    "react-intl": "^7.1.0",
    "react-markdown": "^9.0.3",
    "react-select": "^5.9.0",
    "react-toastify": "^11.0.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.3.15",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^18.3.18",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-formatjs": "^4.13.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react": "^7.37.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
