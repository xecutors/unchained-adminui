{
  "name": "admin-ui",
  "private": true,
  "version": "3.0.2",
  "description": "Unchained commerce Admin UI",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev ",
    "dev:turbo": "NODE_OPTIONS='--inspect' next dev --turbo ",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "eslint --fix --ext .ts,.tsx,.js,.jsx .",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json --format custom-formatter.js",
    "test:e2e": "cypress open",
    "test:component": "cypress open --component",
    "test:e2e-record": "cypress run --browser chrome --record",
    "version:patch": "npm version patch && npm run tag",
    "version:minor": "npm version minor && npm run tag",
    "version:major": "npm version major && npm run tag",
    "tag": "git push --follow-tags",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "contributors": [
    "Vedran Rudelj <vedran@unchained.shop> (http://www.unchained.shop)",
    "Pascal Kaufmann <pascal@unchained.shop> (http://www.unchained.shop)",
    "Mikael Araya Mengistu <mikael@unchained.shop> (http://www.unchained.shop)"
  ],
  "dependencies": {
    "@apollo/client": "^3.11.4",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/intl-pluralrules": "^5.2.14",
    "@formatjs/intl-relativetimeformat": "^11.2.14",
    "@graphql-tools/links": "^9.0.1",
    "@graphql-tools/wrap": "^10.0.5",
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.1.5",
    "@tailwindcss/forms": "^0.5.7",
    "accepts": "^1.3.8",
    "chart.js": "^4.4.3",
    "classnames": "^2.5.1",
    "cookie": "^0.5.0",
    "cross-fetch": "^4.0.0",
    "crypto-hash": "^2.0.1",
    "d3": "^7.9.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "deepmerge": "^4.3.1",
    "dotenv-extended": "^2.9.0",
    "formik": "^2.4.6",
    "graphql": "^16.9.0",
    "http-proxy-middleware": "^3.0.0",
    "intl-messageformat": "^10.3.1",
    "isomorphic-unfetch": "^4.0.2",
    "lodash": "^4.17.21",
    "lodash.isequal": "^4.5.0",
    "next": "^14.2.5",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-intl": "^6.6.8",
    "react-markdown": "^8.0.7",
    "react-select": "^5.8.0",
    "react-toastify": "^9.1.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.2.12",
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/introspection": "4.0.0",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^3.3.7",
    "@tailwindcss/typography": "^0.5.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^12.17.4",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^14.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-formatjs": "^4.13.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
